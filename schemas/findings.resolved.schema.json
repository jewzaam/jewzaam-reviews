              "status": {
                "description": "ok = ran and nothing was lost. degraded = ran, but part of its work did not land (some agents failed, a fallback was taken). skipped = deliberately not run for this scope or mode. failed = aborted the run.",
                "enum": [
                  "ok",
                  "degraded",
                  "skipped",
                  "failed"
                ]
              },
              "step": {
                "description": "Pipeline step name, e.g. scope, select, review, validate.",
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "step",
              "status"
            ],
            "type": "object",
            "unevaluatedProperties": false
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "status",
        "steps"
      ],
      "type": "object",
      "unevaluatedProperties": false
    },
    "schema_version": {
      "description": "SemVer string, aligned with the plugin version at the time the document was written (.claude-plugin/plugin.json version). Consumers read this to identify which plugin release produced the envelope.",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-((0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*)(\\.(0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*))*))?(\\+([0-9a-zA-Z-]+(\\.[0-9a-zA-Z-]+)*))?$",
      "type": "string"
    },
    "scoring": {
      "description": "Scoring mode used by the producing review run. Absent means categorical (the five-dimension rubric). simple means findings carry direct severity + confidence and omit the categorical dimensions. Only meaningful for source: review.",
      "enum": [
        "categorical",
        "simple"
      ]
    },
    "source": {
      "description": "The producing skill, or the shape of the output for consumer skills. `update-pr` is absent deliberately \u2014 it emits review-shaped findings (with optional `pr_comment` fields) under `source: \"review\"`.",
      "enum": [
        "review",
        "standards",
        "c4-reverse-engineer",
        "apply-review"
      ]
    },
    "supplementary": {
      "description": "Optional source-specific metadata that the render script uses to produce supplementary markdown. Not part of the cross-skill handoff contract; consumers may ignore it. Shape is defined by each producer skill.",
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "source",
    "project",
    "findings",
    "issues"
  ],
  "title": "Findings (cross-skill handoff)",
  "type": "object",
  "unevaluatedProperties": false
}
