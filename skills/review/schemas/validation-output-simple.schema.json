{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jewzaam/jewzaam-reviews/skills/review/schemas/validation-output-simple.schema.json",
  "title": "Validation Output (simple scoring)",
  "description": "Verdicts from one validator agent for one batch of simple-scored findings. Rescore updates severity/confidence directly instead of the categorical dimensions.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "batch_number",
    "verdicts"
  ],
  "properties": {
    "batch_number": {
      "type": "integer",
      "minimum": 1
    },
    "verdicts": {
      "type": "array",
      "minItems": 1,
      "description": "One verdict per finding, as a closed union discriminated by `action`. Written as `anyOf` over three complete shapes rather than a shared object plus `allOf`/`if`/`then` conditionals: `anyOf` is the only composition keyword OpenAI's strict Structured Outputs accepts, so the conditional form was rejected outright under Codex and the per-action rules had to be re-checked after generation instead of enforced during it. The union is equivalent and holds on both harnesses. Nested composition is fine on both; only ROOT-level composition is rejected (see scripts/resolve_schema.py).",
      "items": {
        "anyOf": [
          {
            "$ref": "#/$defs/confirm"
          },
          {
            "$ref": "#/$defs/rescore"
          },
          {
            "$ref": "#/$defs/remove"
          }
        ]
      }
    }
  },
  "$defs": {
    "confirm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finding_ref",
        "action",
        "reasoning"
      ],
      "properties": {
        "finding_ref": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "content_hash"
          ],
          "properties": {
            "content_hash": {
              "type": "string",
              "pattern": "^[a-f0-9]{16,64}$"
            }
          }
        },
        "action": {
          "type": "string",
          "const": "confirm"
        },
        "reasoning": {
          "type": "string",
          "pattern": "^[\\s\\S]+$"
        }
      }
    },
    "rescore": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finding_ref",
        "action",
        "new_severity",
        "new_confidence",
        "reasoning"
      ],
      "properties": {
        "finding_ref": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "content_hash"
          ],
          "properties": {
            "content_hash": {
              "type": "string",
              "pattern": "^[a-f0-9]{16,64}$"
            }
          }
        },
        "action": {
          "type": "string",
          "const": "rescore"
        },
        "new_severity": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "critical",
                "important",
                "suggestion"
              ],
              "description": "Corrected severity. Optional alongside new_confidence; a severity change always ships with the confidence the renderer will bucket on, because the needs-review bucket is derived from confidence and a stale low confidence would silently override a raised severity."
            },
            {
              "type": "null"
            }
          ]
        },
        "new_confidence": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low"
          ],
          "description": "Corrected confidence. Always present on a rescore."
        },
        "reasoning": {
          "type": "string",
          "pattern": "^[\\s\\S]+$"
        }
      }
    },
    "remove": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finding_ref",
        "action",
        "remove_reason",
        "reasoning"
      ],
      "properties": {
        "finding_ref": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "content_hash"
          ],
          "properties": {
            "content_hash": {
              "type": "string",
              "pattern": "^[a-f0-9]{16,64}$"
            }
          }
        },
        "action": {
          "type": "string",
          "const": "remove"
        },
        "remove_reason": {
          "type": "string",
          "enum": [
            "not_real",
            "pre_existing",
            "positive_observation"
          ],
          "description": "Why the finding was removed. not_real = the issue does not exist or the premise is invalid. pre_existing = the issue is real but would hold at the merge base, so this PR did not introduce or expose it. positive_observation = the finding describes working code, not a problem. Same semantics as validation-output.schema.json."
        },
        "reasoning": {
          "type": "string",
          "pattern": "^[\\s\\S]+$"
        }
      }
    }
  }
}
